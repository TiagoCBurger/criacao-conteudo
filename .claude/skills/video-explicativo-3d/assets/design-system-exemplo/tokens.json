{
  "meta": {
    "name": "Exemplo (substitua pela identidade do projeto)",
    "version": "1.0.0",
    "source": "exemplo da skill video-explicativo-3d — referência de formato, não é identidade de ninguém",
    "notes": "Cores e fontes aqui são placeholders. Todo projeto deve ter o próprio design-system/tokens.json."
  },
  "color": {
    "background": "#0E1116",
    "backgroundAlt": "#151A22",
    "surface": "#1A202B",
    "surfaceAlt": "#2A3240",
    "border": "#3A4352",
    "text": "#F3F5F8",
    "textMuted": "#A3ACBA",
    "textOnPrimary": "#0E1116",
    "primary": "#5B8CFF",
    "secondary": "#8B6CFF",
    "accent": "#FFB547",
    "positive": "#3DD68C",
    "negative": "#FF5C6C",
    "warning": "#FFB547",
    "data": ["#5B8CFF", "#FFB547", "#3DD68C", "#FF6FB5", "#8B6CFF", "#4CD3E8"],
    "gradient": {"from": "#0E1116", "to": "#1B2235", "angle": 165},
    "glow": "#5B8CFF"
  },
  "typography": {
    "display": {
      "family": "Space Grotesk",
      "fallback": "sans-serif",
      "weight": 700,
      "files": [{"src": "fonts/SpaceGrotesk-700.ttf", "weight": 700}],
      "letterSpacing": -0.03,
      "lineHeight": 1.0
    },
    "body": {
      "family": "Inter",
      "fallback": "sans-serif",
      "weight": 500,
      "files": [
        {"src": "fonts/Inter-500.ttf", "weight": 500},
        {"src": "fonts/Inter-700.ttf", "weight": 700}
      ],
      "letterSpacing": -0.01,
      "lineHeight": 1.3
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "monospace",
      "weight": 500,
      "files": [{"src": "fonts/JetBrainsMono-500.ttf", "weight": 500}],
      "lineHeight": 1.4
    },
    "scale": {"hero": 200, "h1": 112, "h2": 84, "h3": 60, "body": 44, "small": 34, "label": 28}
  },
  "shape": {"radius": {"sm": 12, "md": 24, "lg": 40}, "strokeWidth": 4, "corner": "rounded"},
  "layout": {"margin": 72, "gap": 40, "safe": {"top": 220, "bottom": 360, "left": 72, "right": 120}},
  "surface": {"style": "glass", "blur": 24},
  "background": {"style": "radial", "grain": 0.06, "vignette": 0.35, "patternOpacity": 0.06},
  "motion": {
    "personality": "confident",
    "easing": {"standard": [0.65, 0, 0.35, 1], "enter": [0.16, 1, 0.3, 1], "exit": [0.7, 0, 0.84, 0]},
    "spring": {
      "enter": {"damping": 200, "stiffness": 120, "mass": 1},
      "pop": {"damping": 12, "stiffness": 180, "mass": 0.8},
      "soft": {"damping": 30, "stiffness": 60, "mass": 1.2}
    },
    "duration": {"fast": 0.3, "base": 0.55, "slow": 1.0},
    "stagger": 0.07,
    "transition": {"type": "slide", "duration": 0.45},
    "cameraDrift": 0.35
  },
  "three": {
    "material": "glossy",
    "bevel": 0.08,
    "lighting": "studio",
    "shadows": true,
    "fov": 32,
    "exposure": 1.05
  },
  "captions": {
    "enabled": true,
    "style": "karaoke",
    "position": "bottom",
    "maxWords": 4,
    "size": 64,
    "font": "display",
    "textTransform": "none",
    "highlight": "accent",
    "stroke": 0
  },
  "brand": {"watermark": "none", "handle": "@exemplo", "endCard": false},
  "sound": {"palette": "soft", "sfxGain": 0.35, "musicGain": 0.12, "duckTo": 0.35, "transitionSfx": "whoosh-soft"}
}
