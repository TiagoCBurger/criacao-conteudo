{
  "meta": {
    "name": "Funil — 2D técnico",
    "version": "0.1.0",
    "source": "amostra 2D",
    "notes": "Exemplo de design system 2D (técnico escuro). Fontes: Inter Tight 600/800 e JetBrains Mono 500 (baixe com fetch-font.mjs). Cores são da amostra, não de uma marca."
  },
  "art": {
    "direction": "technical",
    "hud": "minimal",
    "medium": "2d"
  },
  "color": {
    "background": "#0D0E10",
    "backgroundAlt": "#131418",
    "surface": "#17181C",
    "surfaceAlt": "#22242A",
    "border": "#2E3038",
    "text": "#F2F2EE",
    "textMuted": "#8D8F96",
    "textOnPrimary": "#0D0E10",
    "primary": "#F2F2EE",
    "secondary": "#5C5F68",
    "accent": "#D7FF3A",
    "positive": "#D7FF3A",
    "negative": "#FF5A3C",
    "data": [
      "#F2F2EE",
      "#D7FF3A",
      "#5C5F68"
    ],
    "glow": "#3A4150"
  },
  "typography": {
    "display": {
      "family": "Inter Tight",
      "fallback": "sans-serif",
      "weight": 800,
      "files": [
        {
          "src": "fonts/InterTight-800.ttf",
          "weight": 800
        }
      ],
      "letterSpacing": -0.045,
      "lineHeight": 0.92
    },
    "body": {
      "family": "Inter Tight",
      "fallback": "sans-serif",
      "weight": 600,
      "files": [
        {
          "src": "fonts/InterTight-600.ttf",
          "weight": 600
        }
      ],
      "lineHeight": 1.25
    },
    "mono": {
      "family": "JetBrains Mono",
      "fallback": "monospace",
      "weight": 500,
      "files": [
        {
          "src": "fonts/JetBrainsMono-500.ttf",
          "weight": 500
        }
      ],
      "lineHeight": 1.3
    },
    "scale": {
      "hero": 240,
      "h1": 130,
      "h2": 92,
      "h3": 60,
      "body": 44,
      "small": 32,
      "label": 26
    }
  },
  "shape": {
    "radius": {
      "sm": 4,
      "md": 8,
      "lg": 14
    },
    "strokeWidth": 2,
    "corner": "sharp"
  },
  "layout": {
    "margin": 72,
    "gap": 40,
    "safe": {
      "top": 220,
      "bottom": 360,
      "left": 72,
      "right": 120
    }
  },
  "surface": {
    "style": "outline"
  },
  "background": {
    "style": "grid",
    "grain": 0.05,
    "vignette": 0.3,
    "patternOpacity": 0.045,
    "glow": 0.22
  },
  "motion": {
    "personality": "precise",
    "easing": {
      "standard": [
        0.4,
        0,
        0.2,
        1
      ],
      "enter": [
        0.16,
        1,
        0.3,
        1
      ],
      "exit": [
        0.7,
        0,
        0.84,
        0
      ]
    },
    "spring": {
      "enter": {
        "damping": 200,
        "stiffness": 140
      },
      "pop": {
        "damping": 24,
        "stiffness": 160
      },
      "soft": {
        "damping": 40,
        "stiffness": 60,
        "mass": 1.1
      }
    },
    "duration": {
      "fast": 0.3,
      "base": 0.55,
      "slow": 1.0
    },
    "stagger": 0.05,
    "transition": {
      "type": "wipe",
      "duration": 0.45
    },
    "cameraDrift": 0.25
  },
  "three": {
    "material": "wire",
    "geometry": "sharp",
    "edges": true,
    "fog": {
      "near": 1.1,
      "far": 2.8
    },
    "lighting": "flat",
    "bevel": 0.0,
    "shadows": false,
    "fov": 26,
    "exposure": 1.0
  },
  "captions": {
    "enabled": true,
    "style": "minimal",
    "position": "bottom",
    "maxWords": 4,
    "size": 52,
    "font": "body",
    "textTransform": "none",
    "highlight": "text",
    "stroke": 0
  },
  "brand": {
    "watermark": "none",
    "endCard": false
  },
  "sound": {
    "palette": "digital",
    "sfxGain": 0.28,
    "musicGain": 0.12,
    "duckTo": 0.35,
    "transitionSfx": "swish"
  }
}