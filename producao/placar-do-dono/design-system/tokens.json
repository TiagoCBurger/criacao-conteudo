{
  "meta": {
    "name": "Placar do Dono",
    "version": "1.0.0",
    "source": "convertido de identidade/identidade.md em 16/10/2026 (cores e fontes literais); direção de arte, 3D, movimento e som derivados do preset cinematic",
    "notes": "Metáfora: placar de LED de estádio à noite. Âmbar é o único acento forte; verde (lucro) e coral (custo) só para ganho × custo. Ver DESIGN.md."
  },
  "art": {
    "direction": "cinematic",
    "hud": "minimal",
    "medium": "3d"
  },
  "color": {
    "background": "#0E1116",
    "backgroundAlt": "#12161C",
    "surface": "#1A1F27",
    "surfaceAlt": "#252C37",
    "border": "#252C37",
    "text": "#F4F1EA",
    "textMuted": "#A7ADB8",
    "textOnPrimary": "#0E1116",
    "primary": "#A7ADB8",
    "secondary": "#4A5361",
    "accent": "#FFB020",
    "positive": "#34D27B",
    "negative": "#FF5A4E",
    "warning": "#FFB020",
    "data": ["#A7ADB8", "#FFB020", "#FF5A4E", "#34D27B"],
    "glow": "#8FA6C8"
  },
  "typography": {
    "display": {
      "family": "Anton",
      "fallback": "Impact, sans-serif",
      "weight": 400,
      "files": [{"src": "fonts/Anton-400.ttf", "weight": 400}],
      "ttf": "fonts/Anton-400.ttf",
      "letterSpacing": 0.01,
      "lineHeight": 0.95,
      "textTransform": "uppercase"
    },
    "body": {
      "family": "Inter",
      "fallback": "sans-serif",
      "weight": 600,
      "files": [
        {"src": "fonts/Inter-600.ttf", "weight": 600},
        {"src": "fonts/Inter-800.ttf", "weight": 800}
      ],
      "letterSpacing": -0.01,
      "lineHeight": 1.25
    },
    "accent": {
      "family": "Inter",
      "fallback": "sans-serif",
      "weight": 800,
      "files": [{"src": "fonts/Inter-800.ttf", "weight": 800}],
      "letterSpacing": -0.015,
      "lineHeight": 1.1
    },
    "scale": {
      "hero": 280,
      "h1": 150,
      "h2": 104,
      "h3": 68,
      "body": 46,
      "small": 36,
      "label": 30
    }
  },
  "shape": {
    "radius": {"sm": 4, "md": 8, "lg": 14},
    "strokeWidth": 3,
    "corner": "sharp"
  },
  "layout": {
    "margin": 72,
    "gap": 40,
    "safe": {"top": 220, "bottom": 360, "left": 72, "right": 120}
  },
  "surface": {
    "style": "solid"
  },
  "background": {
    "style": "radial",
    "grain": 0.06,
    "vignette": 0.55,
    "glow": 0.16
  },
  "motion": {
    "personality": "confident",
    "easing": {
      "standard": [0.45, 0, 0.55, 1],
      "enter": [0.16, 1, 0.3, 1],
      "exit": [0.7, 0, 0.84, 0]
    },
    "spring": {
      "enter": {"damping": 200, "stiffness": 100},
      "pop": {"damping": 18, "stiffness": 140},
      "soft": {"damping": 40, "stiffness": 50, "mass": 1.2}
    },
    "duration": {"fast": 0.35, "base": 0.65, "slow": 1.1},
    "stagger": 0.08,
    "transition": {"type": "blur", "duration": 0.5},
    "cameraDrift": 0.35
  },
  "three": {
    "material": "matte",
    "roughness": 0.78,
    "geometry": "sharp",
    "edges": false,
    "fog": {"near": 1.05, "far": 2.4},
    "lighting": "dramatic",
    "bevel": 0.02,
    "shadows": true,
    "fov": 26,
    "exposure": 1.0
  },
  "captions": {
    "enabled": true,
    "style": "minimal",
    "position": "bottom",
    "maxWords": 4,
    "size": 54,
    "font": "body",
    "textTransform": "none",
    "highlight": "text",
    "stroke": 0
  },
  "brand": {
    "watermark": "none",
    "endCard": false
  },
  "sound": {
    "palette": "crisp",
    "sfxGain": 0.3,
    "musicGain": 0.12,
    "duckTo": 0.35,
    "transitionSfx": "whoosh-soft"
  }
}
